PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/swilogistics

# RabbitMQ
RABBITMQ_URL=amqp://localhost

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Client Portal
CLIENT_ORIGIN=http://localhost:3000

# External APIs
CMS_SOAP_ENDPOINT=http://localhost:8080/cms/soap
ROS_REST_ENDPOINT=http://localhost:8081/ros/api
WMS_TCP_HOST=localhost
WMS_TCP_PORT=9092

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
